<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Small bold label shown above each input -->
    <style name="FarmerFormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">#33513B</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Bold section headers: "Bank Details", "Revenue Details", etc. -->
    <style name="FarmerFormSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/accent_bar</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:textColor">#1B5E20</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Read-only fields inside the "Registered Information" box -->
    <style name="FarmerPrefilledField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/prefilled_field_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#37474F</item>
        <item name="android:textColorHint">#12BE80</item>
        <item name="android:textSize">14sp</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:longClickable">false</item>
        <item name="android:cursorVisible">false</item>
    </style>

    <!-- Same as above, but the last item in the box (no bottom margin) -->
    <style name="FarmerPrefilledFieldLast" parent="FarmerPrefilledField">
        <item name="android:layout_marginBottom">0dp</item>
    </style>

    <!-- Normal editable text field -->
    <style name="FarmerEditableField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/edittext_bg</item>
        <item name="android:elevation">2dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textColorHint">#757575</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- FrameLayout wrapping a Spinner + dropdown arrow -->
    <style name="FarmerDropdownContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/edittext_bg</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Same container, extra bottom margin before the next section -->
    <style name="FarmerDropdownContainerLargeMargin" parent="FarmerDropdownContainer">
        <item name="android:layout_marginBottom">26dp</item>
    </style>

    <style name="FarmerDropdownSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">42dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>

    <style name="FarmerDropdownArrow">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_gravity">center_vertical|end</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:src">@drawable/ic_dropdown_arrow</item>
    </style>

    <!-- Secondary outlined button for document uploads -->
    <style name="FarmerUploadButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/upload_button_bg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#1B5E20</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Small italic caption under each upload button -->
    <style name="FarmerSelectedFileText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">start</item>
        <item name="android:textColor">#6B8F72</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">italic</item>
    </style>


    <style name="DetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="DetailLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">0.4</item>
        <item name="android:textColor">#718176</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DetailValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">0.6</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">#1C2B1F</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DetailSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textColor">#2E7D32</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="DetailDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">#E6ECE7</item>
    </style>

    <style name="StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#1B5E20</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">#6B7C6E</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>