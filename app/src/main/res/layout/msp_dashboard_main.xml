<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">

    <!-- Soft dark-green overlay for contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:background="#0D2B14" />

    <!-- Scrollable Dashboard -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="10dp"
            android:paddingBottom="14dp">

            <!-- ==================== WELCOME CARD ==================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/login_card_bg"
                android:elevation="10dp"
                android:outlineAmbientShadowColor="#1B5E20"
                android:outlineSpotShadowColor="#1B5E20"
                android:gravity="center_vertical"
                android:maxWidth="600dp"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <!-- Profile Icon (48dp touch target, 28dp icon) -->
                <ImageView
                    android:id="@+id/btnProfile"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="MSP Profile"
                    android:focusable="true"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_profile"
                    android:tint="#1B5E20" />

                <!-- Welcome Text -->
                <TextView
                    android:id="@+id/txtWelcomeMSP"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="start|center_vertical"
                    android:maxLines="2"
                    android:text="MSP User Name"
                    android:textColor="#1B5E20"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <!-- Logout Icon (48dp touch target, 28dp icon) -->
                <ImageView
                    android:id="@+id/btnLogout"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Logout"
                    android:focusable="true"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_logout"
                    android:tint="#D32F2F" />

            </LinearLayout>


            <!-- ==================== MAIN DASHBOARD CARD ==================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/login_card_bg"
                android:elevation="10dp"
                android:outlineAmbientShadowColor="#1B5E20"
                android:outlineSpotShadowColor="#1B5E20"
                android:gravity="center_horizontal"
                android:maxWidth="600dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="18dp"
                android:paddingEnd="12dp"
                android:paddingBottom="18dp">

                <!-- Dashboard Heading -->
                <TextView
                    android:id="@+id/txtDashboardHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/subtitle_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:paddingStart="13dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="5dp"
                    android:shadowColor="#33000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="MSP's Dashboard"
                    android:textColor="#1B5E20"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <View
                    style="@style/DetailDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="16dp" />


                <!-- ==================== ROW 1 ==================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- View Profile -->
                    <LinearLayout
                        android:id="@+id/btnViewProfile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/login_button_bg"
                        android:clickable="true"
                        android:elevation="6dp"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="120dp"
                        android:orientation="vertical"
                        android:padding="9dp">

                        <ImageView
                            android:id="@+id/imgViewProfile"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="View Profile"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_farmer_profile" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:letterSpacing="0.01"
                            android:maxLines="2"
                            android:text="View Profile"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>


                    <!-- Monitor Details -->
                    <LinearLayout
                        android:id="@+id/btnMonitorDetails"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/login_button_bg"
                        android:clickable="true"
                        android:elevation="6dp"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="120dp"
                        android:orientation="vertical"
                        android:padding="9dp">

                        <ImageView
                            android:id="@+id/imgMonitorDetails"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Monitor Details"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_monitor_details" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:letterSpacing="0.01"
                            android:maxLines="2"
                            android:text="Monitor Details"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Row Spacing -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />


                <!-- ==================== ROW 2 ==================== -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Current Slot Book -->
                    <LinearLayout
                        android:id="@+id/btnCurrentSlotBook"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/login_button_bg"
                        android:clickable="true"
                        android:elevation="6dp"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="120dp"
                        android:orientation="vertical"
                        android:padding="9dp">

                        <ImageView
                            android:id="@+id/imgCurrentSlotBook"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Book Current Slot"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_book_slot" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:letterSpacing="0.01"
                            android:maxLines="2"
                            android:text="Book Current Slot"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>


                    <!-- Reports -->
                    <LinearLayout
                        android:id="@+id/btnMSPReport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/login_button_bg"
                        android:clickable="true"
                        android:elevation="6dp"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="120dp"
                        android:orientation="vertical"
                        android:padding="9dp">

                        <ImageView
                            android:id="@+id/imgMSPReport"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="Reports"
                            android:padding="4dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_report" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:letterSpacing="0.01"
                            android:maxLines="2"
                            android:text="Reports"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ==================== MSP CAPACITY DETAILS ==================== -->

                <!-- Spacing after Row 2 -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="14dp" />

                <!-- MSP Capacity Group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_section_group"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <!-- MSP Capacity -->
                    <LinearLayout style="@style/DetailRow">

                        <TextView
                            style="@style/DetailLabel"
                            android:text="MSP Capacity" />

                        <TextView
                            android:id="@+id/txtMspCapacity"
                            style="@style/DetailValue"
                            android:text="0 Qntls" />

                    </LinearLayout>

                    <View
                        style="@style/DetailDivider"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp" />

                    <!-- Total Paddy Procured -->
                    <LinearLayout style="@style/DetailRow">

                        <TextView
                            style="@style/DetailLabel"
                            android:text="Total Paddy Procured" />

                        <TextView
                            android:id="@+id/txtTotalPaddyProcured"
                            style="@style/DetailValue"
                            android:text="0 Qntls" />

                    </LinearLayout>

                    <View
                        style="@style/DetailDivider"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp" />

                    <!-- Total Paddy Sent to Miller -->
                    <LinearLayout style="@style/DetailRow">

                        <TextView
                            style="@style/DetailLabel"
                            android:text="Total Paddy sent to Miller" />

                        <TextView
                            android:id="@+id/txtTotalPaddySentMiller"
                            style="@style/DetailValue"
                            android:text="0 Qntls" />

                    </LinearLayout>

                    <View
                        style="@style/DetailDivider"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp" />

                    <!-- Total Paddy Sent to Warehouse -->
                    <LinearLayout style="@style/DetailRow">

                        <TextView
                            style="@style/DetailLabel"
                            android:text="Total Paddy sent to Warehouse" />

                        <TextView
                            android:id="@+id/txtTotalPaddySentWarehouse"
                            style="@style/DetailValue"
                            android:text="0 Qntls" />

                    </LinearLayout>

                    <View
                        style="@style/DetailDivider"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp" />

                    <!-- Remaining Paddy -->
                    <LinearLayout style="@style/DetailRow">

                        <TextView
                            style="@style/DetailLabel"
                            android:text="Remaining Paddy" />

                        <TextView
                            android:id="@+id/txtRemainingPaddy"
                            style="@style/DetailValue"
                            android:text="0 Qntls" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>

