<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/edittext_bg"
    android:elevation="12dp"
    android:gravity="center"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="#1B5E20"
    android:outlineSpotShadowColor="#1B5E20"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- OTP instruction -->
    <TextView
        android:id="@+id/txtOtpMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="4dp"
        android:shadowColor="#22000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:text="Enter the OTP sent to the mobile number"
        android:textColor="#1B5E20"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- OTP Input -->
    <EditText
        android:id="@+id/edtOtp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/edittext_bg"
        android:digits="0123456789"
        android:elevation="3dp"
        android:gravity="center"
        android:hint="Enter 4-digit OTP"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="4"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:textColor="#212121"
        android:textColorHint="#757575"
        android:textSize="18sp" />

    <!-- Cancel and Verify Buttons -->
    <LinearLayout
        android:id="@+id/layoutOtpButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelOtp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg"
            android:elevation="6dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg"
            android:elevation="6dp"
            android:text="Verify"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>