<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">

    <!-- Soft dark-green overlay for contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:background="#0D2B14" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Registration Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="12dp"
                android:background="@drawable/login_card_bg"
                android:elevation="18dp"
                android:outlineAmbientShadowColor="#1B5E20"
                android:outlineSpotShadowColor="#1B5E20"
                android:gravity="center_horizontal"
                android:maxWidth="550dp"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="28dp"
                android:paddingEnd="22dp"
                android:paddingBottom="26dp">

                <!-- Logo badge -->
                <FrameLayout
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/logo_badge_bg"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="Government Logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mpgov_logo" />

                </FrameLayout>
                <!-- Title -->
                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/subtitle_chip_bg"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:shadowColor="#33000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:text="Farmer Registration"
                    android:textColor="#1B5E20"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Decorative divider -->
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="3dp"
                    android:layout_marginBottom="20dp"
                    android:background="#66BB6A" />

                <!-- District Spinner Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/edittext_bg"
                    android:elevation="2dp"
                    android:outlineAmbientShadowColor="#A9DBB4"
                    android:outlineSpotShadowColor="#A9DBB4">

                    <Spinner
                        android:id="@+id/spDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="14dp"
                        android:paddingEnd="42dp"
                        android:spinnerMode="dropdown" />

                    <ProgressBar
                        android:id="@+id/progressDistrict"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Name -->
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/edittext_bg"
                    android:drawableStart="@android:drawable/ic_menu_myplaces"
                    android:drawablePadding="10dp"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:hint="Enter Name"
                    android:inputType="textPersonName"
                    android:maxLength="100"
                    android:minHeight="50dp"
                    android:outlineAmbientShadowColor="#A9DBB4"
                    android:outlineSpotShadowColor="#A9DBB4"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#757575" />

                <!-- Mobile Number Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical">

                    <!-- Mobile Number -->
                    <EditText
                        android:id="@+id/etMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_bg"
                        android:drawableStart="@android:drawable/ic_menu_call"
                        android:drawablePadding="10dp"
                        android:elevation="2dp"
                        android:gravity="center_vertical"
                        android:hint="Enter Mobile Number"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:minHeight="50dp"
                        android:outlineAmbientShadowColor="#A9DBB4"
                        android:outlineSpotShadowColor="#A9DBB4"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="#000000"
                        android:textColorHint="#757575" />

                    <!-- Mobile duplicate-registration status -->
                    <TextView
                        android:id="@+id/txtMobileRegistrationStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:gravity="start"
                        android:textColor="#8B0000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Verification Row -->
                <LinearLayout
                    android:id="@+id/layoutAadhaarVerification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Input field with verified icon inside -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_bg"
                        android:elevation="2dp"
                        android:outlineAmbientShadowColor="#A9DBB4"
                        android:outlineSpotShadowColor="#A9DBB4">

                        <EditText
                            android:id="@+id/etAadhaar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:drawableStart="@android:drawable/ic_menu_edit"
                            android:drawablePadding="8dp"
                            android:gravity="center_vertical"
                            android:hint="Enter Aadhaar No."
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="12"
                            android:paddingStart="12dp"
                            android:paddingEnd="48dp"
                            android:textColor="#000000"
                            android:textColorHint="#757575" />

                        <ImageView
                            android:id="@+id/imgAadhaarVerified"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="Verification successful"
                            android:padding="4dp"
                            android:src="@drawable/ic_verified_green"
                            android:visibility="gone" />

                    </FrameLayout>

                    <Button
                        android:id="@+id/btnVerifyAadhaar"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_bg"
                        android:elevation="4dp"
                        android:minWidth="78dp"
                        android:minHeight="0dp"
                        android:outlineAmbientShadowColor="#1B5E20"
                        android:outlineSpotShadowColor="#1B5E20"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Verify"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressAadhaar"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Verification duplicate status -->
                <TextView
                    android:id="@+id/txtAadhaarRegistrationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="start"
                    android:textColor="#8B0000"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Verification message status -->
                <TextView
                    android:id="@+id/txtAadhaarVerificationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:gravity="start"
                    android:textColor="#06402B"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Password -->
                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/edittext_bg"
                    android:drawableStart="@android:drawable/ic_lock_lock"
                    android:drawablePadding="10dp"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:hint="Enter Password"
                    android:inputType="textPassword"
                    android:maxLength="50"
                    android:minHeight="50dp"
                    android:outlineAmbientShadowColor="#A9DBB4"
                    android:outlineSpotShadowColor="#A9DBB4"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#000000"
                    android:textColorHint="#757575" />

                <!-- Confirmation -->
                <CheckBox
                    android:id="@+id/chkConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:buttonTint="#43A047"
                    android:text="I confirm that the above information is correct."
                    android:textColor="#33513B"
                    android:textSize="14sp" />

                <!-- Submit Button Container -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">

                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/button_bg"
                        android:elevation="8dp"
                        android:enabled="false"
                        android:letterSpacing="0.03"
                        android:outlineAmbientShadowColor="#1B5E20"
                        android:outlineSpotShadowColor="#1B5E20"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- Click interceptor when disabled -->
                    <View
                        android:id="@+id/submitBlocker"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="true" />

                    <!-- Registration Loading Indicator -->
                    <ProgressBar
                        android:id="@+id/progressSubmit"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>