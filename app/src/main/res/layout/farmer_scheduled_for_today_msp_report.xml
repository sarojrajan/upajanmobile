<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">

    <!-- Soft dark-green overlay for contrast -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:background="#0D2B14" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="16dp"
            android:paddingEnd="10dp"
            android:paddingBottom="16dp">

            <!-- Main Report Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="2dp"
                android:background="@drawable/login_card_bg"
                android:elevation="12dp"
                android:outlineAmbientShadowColor="#1B5E20"
                android:outlineSpotShadowColor="#1B5E20"
                android:gravity="center_horizontal"
                android:maxWidth="600dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <!-- Logo + Export Icons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Left balancing space (equal weight to the icons column keeps the badge centered) -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Center Logo badge -->
                    <FrameLayout
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/logo_badge_bg"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/imgLogo"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:contentDescription="Government Logo"
                            android:scaleType="fitCenter"
                            android:src="@drawable/mpgov_logo" />

                    </FrameLayout>

                    <!-- Export Icons (48dp touch targets, 28dp icons) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end|center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnExportExcel"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Export to Excel"
                            android:focusable="true"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_export_excel" />

                        <ImageView
                            android:id="@+id/btnExportPdf"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Export to PDF"
                            android:focusable="true"
                            android:padding="10dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_export_pdf" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Report Heading (Headline: 20sp, Roboto Medium; longer title) -->
                <TextView
                    android:id="@+id/txtReportTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/subtitle_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:shadowColor="#26000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="Farmers Scheduled for Today"
                    android:textColor="#1B5E20"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Decorative Divider -->
                <View
                    style="@style/DetailDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp" />

                <!-- Report Table -->
                <LinearLayout
                    android:id="@+id/tableContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#DDDDDD"
                    android:orientation="vertical" />

                <!-- Empty State (Body small: 14sp) -->
                <TextView
                    android:id="@+id/txtEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="#1B5E20"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="No farmers are scheduled for today." />

                <!-- Loading -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>