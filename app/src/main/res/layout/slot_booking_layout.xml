<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">

    <!-- Dark Green Transparent Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:background="#0D2B14" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- Glass-style slot booking card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/login_card_bg"
                android:elevation="12dp"
                android:gravity="center_horizontal"
                android:maxWidth="480dp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="#1B5E20"
                android:outlineSpotShadowColor="#1B5E20"
                android:paddingStart="24dp"
                android:paddingTop="26dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <!-- Page heading -->
                <TextView
                    android:id="@+id/txtSlotBookingHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/subtitle_chip_bg"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:shadowColor="#33000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:text="Slot Booking"
                    android:textColor="#1B5E20"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Decorative divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="#66BB6A" />

                <!-- MSP center -->
                <TextView
                    android:id="@+id/txtSlotMspCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="MSP Center: Not Assigned Yet"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Date label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Slot Date"
                    android:textColor="#1B5E20"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Clickable date selection field -->
                <LinearLayout
                    android:id="@+id/containerSlotDate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/slot_date_bg"
                    android:clickable="true"
                    android:elevation="4dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/txtSelectedSlotDate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="Please select a date"
                        android:textColor="#5F6B76"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/imgSlotCalendar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="Open calendar"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_calendar"
                        android:tint="#1B5E20" />

                </LinearLayout>

                <!-- Loading indicator -->
                <ProgressBar
                    android:id="@+id/progressBookSlot"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="24dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <!-- Book Slot Button -->
                <Button
                    android:id="@+id/btnConfirmBookSlot"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/button_bg"
                    android:elevation="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="0dp"
                    android:text="Book Slot"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>