<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">

    <!-- Green Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:background="#0D2B14" />

    <!-- ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <!-- Glass Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/login_card_bg"
                android:elevation="12dp"
                android:gravity="center_horizontal"
                android:maxWidth="480dp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="#1B5E20"
                android:outlineSpotShadowColor="#1B5E20"
                android:paddingStart="24dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <!-- Logo badge -->
                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/logo_badge_bg"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="Government Logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mpgov_logo" />

                </FrameLayout>

                <!-- Heading -->
                <TextView
                    android:id="@+id/txtHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/subtitle_chip_bg"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:shadowColor="#33000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:text="Official Login"
                    android:textColor="#1B5E20"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Decorative divider -->
                <View
                    style="@style/DetailDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1.5dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp" />

                <!-- MSP Login -->
                <LinearLayout
                    android:id="@+id/btnMSPLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/login_button_bg"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#1B5E20"
                    android:outlineSpotShadowColor="#1B5E20"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="MSP Center Login Icon"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_msp_login_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="MSP Center Login"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Miller Login -->
                <LinearLayout
                    android:id="@+id/btnMillerLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/login_button_bg"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#1B5E20"
                    android:outlineSpotShadowColor="#1B5E20"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Miller Login Icon"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_msp_login_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Miller Login"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- DSO Login -->
                <LinearLayout
                    android:id="@+id/btnDSOLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/login_button_bg"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#1B5E20"
                    android:outlineSpotShadowColor="#1B5E20"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="DSO Login Icon"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_msp_login_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="DSO Login"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- DMSFC Login -->
                <LinearLayout
                    android:id="@+id/btnDMSFCLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/login_button_bg"
                    android:clickable="true"
                    android:elevation="8dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#1B5E20"
                    android:outlineSpotShadowColor="#1B5E20"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="DMSFC Login Icon"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_msp_login_logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="DMSFC Login"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>