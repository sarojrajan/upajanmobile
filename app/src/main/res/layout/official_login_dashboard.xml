<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg">

    <!-- Soft dark-green overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:background="#0D2B14" />

    <!-- Centered Scrollable Login Options -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:gravity="center"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- ==================== MAIN LOGIN CARD ==================== -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/login_card_bg"
                android:elevation="10dp"
                android:gravity="center_horizontal"
                android:maxWidth="480dp"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="#1B5E20"
                android:outlineSpotShadowColor="#1B5E20"
                android:paddingStart="18dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">

                <!-- Logo Badge -->
                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/logo_badge_bg"
                    android:elevation="6dp">

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="Government Logo"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mpgov_logo" />

                </FrameLayout>

                <!-- Heading -->
                <TextView
                    android:id="@+id/txtHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/subtitle_chip_bg"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.01"
                    android:paddingStart="12dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp"
                    android:shadowColor="#22000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="Official Login"
                    android:textColor="#1B5E20"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Divider -->
                <View
                    style="@style/DetailDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp" />


                <!-- ==================== MSP LOGIN ==================== -->

                <LinearLayout
                    android:id="@+id/btnMSPLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/login_button_bg"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#1B5E20"
                    android:outlineSpotShadowColor="#1B5E20"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/icon_badge_bg">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="MSP Center Login Icon"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_msp_login_logo" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="MSP Center Login"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                </LinearLayout>


                <!-- ==================== MILLER LOGIN ==================== -->

                <LinearLayout
                    android:id="@+id/btnMillerLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/login_button_bg"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#1B5E20"
                    android:outlineSpotShadowColor="#1B5E20"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/icon_badge_bg">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="Miller Login Icon"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_msp_login_logo" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="Miller Login"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                </LinearLayout>


                <!-- ==================== DSO LOGIN ==================== -->

                <LinearLayout
                    android:id="@+id/btnDSOLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/login_button_bg"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#1B5E20"
                    android:outlineSpotShadowColor="#1B5E20"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/icon_badge_bg">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="DSO Login Icon"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_msp_login_logo" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="DSO Login"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                </LinearLayout>


                <!-- ==================== DMSFC LOGIN ==================== -->

                <LinearLayout
                    android:id="@+id/btnDMSFCLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/login_button_bg"
                    android:clickable="true"
                    android:elevation="6dp"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="#1B5E20"
                    android:outlineSpotShadowColor="#1B5E20"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <FrameLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/icon_badge_bg">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:contentDescription="DMSFC Login Icon"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_msp_login_logo" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="DMSFC Login"
                        android:textColor="@android:color/white"
                        android:textSize="16sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>